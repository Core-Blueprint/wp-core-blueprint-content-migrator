msgid "%1$s · %2$d/%3$d processed"
msgstr "%1$s · %2$d/%3$d procesados"

msgid "%d issues were recorded. Do not finalize before verification passes."
msgstr "Se registraron %d problemas. No finalices la migración antes de que la verificación sea correcta."

msgid "%d source posts found. Copies are created first; the source is not moved or deleted during testing."
msgstr "Se encontraron %d entradas de origen. Primero se crean las copias; el origen no se mueve ni se elimina durante las pruebas."

msgid "%d source terms found."
msgstr "Se encontraron %d términos de origen."

msgid "A mapped target meta key is reserved or not writable."
msgstr "Una clave meta de destino asignada está reservada o no se puede escribir."

msgid "A mapped target term meta key is reserved or not writable."
msgstr "Una clave meta de término de destino asignada está reservada o no se puede escribir."

msgid "A mapped taxonomy is no longer available for the selected target post type."
msgstr "Una taxonomía asignada ya no está disponible para el tipo de contenido de destino seleccionado."

msgid "A migration can only be finalized after a successful verification."
msgstr "Una migración solo puede finalizarse después de una verificación correcta."

msgid "A target term could not be marked for safe rollback and was removed."
msgstr "Un término de destino no pudo marcarse para una reversión segura y fue eliminado."

msgid "Active migration"
msgstr "Migración activa"

msgid "Analysis complete. Review the plan below."
msgstr "Análisis completado. Revisa el plan a continuación."

msgid "Analyze post migration"
msgstr "Analizar migración de entradas"

msgid "Analyze taxonomy migration"
msgstr "Analizar migración de taxonomía"

msgid "Another migration became active before this job could be started."
msgstr "Otra migración pasó a estar activa antes de que esta tarea pudiera iniciarse."

msgid "Another migration is already active."
msgstr "Ya hay otra migración activa."

msgid "Batch complete."
msgstr "Lote completado."

msgid "Batch size"
msgstr "Tamaño del lote"

msgid "Choose only mappings you understand. Missing target terms may be created and are included in rollback. Machine-owned target taxonomies are excluded."
msgstr "Elige solo asignaciones que entiendas. Los términos de destino que falten pueden crearse y se incluyen en la reversión. Se excluyen las taxonomías de destino gestionadas por máquinas."

msgid "Confirm that you want to move the source posts to WordPress Trash."
msgstr "Confirma que quieres mover las entradas de origen a la papelera de WordPress."

msgid "Confirm that you want to permanently delete the targets created by this migration."
msgstr "Confirma que quieres eliminar de forma permanente los destinos creados por esta migración."

msgid "Confirm that you want to take ownership of this migration."
msgstr "Confirma que quieres asumir la responsabilidad de esta migración."

msgid "Conflict rule: an existing target term with the same slug is reused and never overwritten. Only newly created terms receive mapped term meta and rollback markers."
msgstr "Regla de conflicto: un término de destino existente con el mismo slug se reutiliza y nunca se sobrescribe. Solo los términos recién creados reciben los metadatos de término asignados y los marcadores de reversión."

msgid "Content Migrator"
msgstr "Content Migrator"

msgid "Content migration action failed"
msgstr "Falló la acción de migración de contenido"

msgid "Content migration analysis completed"
msgstr "Análisis de migración de contenido completado"

msgid "Content migration batch copied"
msgstr "Lote de migración de contenido copiado"

msgid "Content migration created"
msgstr "Migración de contenido creada"

msgid "Content migration finalization failed"
msgstr "Falló la finalización de la migración de contenido"

msgid "Content migration finalized"
msgstr "Migración de contenido finalizada"

msgid "Content migration ownership taken over"
msgstr "Responsabilidad de la migración de contenido asumida"

msgid "Content migration plan cleared"
msgstr "Plan de migración de contenido borrado"

msgid "Content migration rollback failed"
msgstr "Falló la reversión de la migración de contenido"

msgid "Content migration rolled back"
msgstr "Migración de contenido revertida"

msgid "Content migration source moved to Trash"
msgstr "Origen de la migración de contenido movido a la papelera"

msgid "Content migration verified"
msgstr "Migración de contenido verificada"

msgid "Copies terms and hierarchy. Existing target terms with the same slug are reused without overwriting their data. Relationships can be remapped when both taxonomies support the same post types."
msgstr "Copia términos y jerarquía. Los términos de destino existentes con el mismo slug se reutilizan sin sobrescribir sus datos. Las relaciones pueden reasignarse cuando ambas taxonomías admiten los mismos tipos de contenido."

msgid "Copy WordPress content safely, verify it, then roll back or finalize. Analysis is read-only and source content stays intact until you explicitly choose otherwise."
msgstr "Copia contenido de WordPress de forma segura, verifícalo y después revierte o finaliza la migración. El análisis es de solo lectura y el contenido de origen permanece intacto hasta que elijas explícitamente otra opción."

msgid "Copy options"
msgstr "Opciones de copia"

msgid "Core Blueprint Content Migrator"
msgstr "Core Blueprint Content Migrator"

msgid "Core Blueprint Content Migrator requires Core Blueprint %1$s or newer with compatible Core API %2$s."
msgstr "Core Blueprint Content Migrator requiere Core Blueprint %1$s o posterior con Core API %2$s compatible."

msgid "Could not remove migrated relationships from object %d."
msgstr "No se pudieron eliminar las relaciones migradas del objeto %d."

msgid "Create safe migration job"
msgstr "Crear tarea de migración segura"

msgid "Created target term %d differs in name or description."
msgstr "El término de destino creado %d difiere en el nombre o la descripción."

msgid "Created target term %d has an invalid source marker."
msgstr "El término de destino creado %d tiene un marcador de origen no válido."

msgid "Created target term %d has an unexpected parent."
msgstr "El término de destino creado %d tiene un padre inesperado."

msgid "Created target term %d no longer has the expected rollback marker."
msgstr "El término de destino creado %d ya no tiene el marcador de reversión esperado."

msgid "Created terms in taxonomy %s could not be removed because the taxonomy is unavailable or no longer manageable."
msgstr "Los términos creados en la taxonomía %s no se pudieron eliminar porque la taxonomía no está disponible o ya no se puede gestionar."

msgid "Finalization did not complete. The migration remains active and its rollback markers are still preserved."
msgstr "La finalización no se completó. La migración sigue activa y sus marcadores de reversión se conservan."

msgid "Finalization needs attention. The migration remains active."
msgstr "La finalización requiere atención. La migración sigue activa."

msgid "Finalize"
msgstr "Finalizar"

msgid "Finalize & keep source"
msgstr "Finalizar y conservar el origen"

msgid "Finalize & keep source taxonomy"
msgstr "Finalizar y conservar la taxonomía de origen"

msgid "Finalize & move source to Trash"
msgstr "Finalizar y mover el origen a la papelera"

msgid "Finish copying all batches before verification."
msgstr "Termina de copiar todos los lotes antes de la verificación."

msgid "For a first test, keep the source. Moving source posts to Trash is available only after verification passes."
msgstr "Para una primera prueba, conserva el origen. Mover las entradas de origen a la papelera solo está disponible después de una verificación correcta."

msgid "I understand that I am taking responsibility for this active migration."
msgstr "Entiendo que asumo la responsabilidad de esta migración activa."

msgid "I understand that rollback permanently deletes targets owned by this migration job."
msgstr "Entiendo que la reversión elimina de forma permanente los destinos que pertenecen a esta tarea de migración."

msgid "I understand that the verified source posts will be moved to WordPress Trash."
msgstr "Entiendo que las entradas de origen verificadas se moverán a la papelera de WordPress."

msgid "Invalid target %1$s meta key: %2$s"
msgstr "Clave meta de destino no válida para %1$s: %2$s"

msgid "Items per request. Use a lower value on slower shared hosting."
msgstr "Elementos por solicitud. Usa un valor menor en alojamientos compartidos más lentos."

msgid "Leave a target key empty to skip it. Registered target keys are shown as suggestions, but another valid key may be entered explicitly."
msgstr "Deja una clave de destino vacía para omitirla. Las claves de destino registradas se muestran como sugerencias, pero también puedes introducir explícitamente otra clave válida."

msgid "Mapped post meta could not be written to the target post."
msgstr "Los metadatos de entrada asignados no se pudieron escribir en la entrada de destino."

msgid "Mapped term meta could not be written to the target term."
msgstr "Los metadatos de término asignados no se pudieron escribir en el término de destino."

msgid "Migrated relationships on object %d were not removed because you no longer have permission."
msgstr "Las relaciones migradas del objeto %d no se eliminaron porque ya no tienes permiso."

msgid "Migration action failed."
msgstr "Falló la acción de migración."

msgid "Migration analysis expired. Analyze the source and target again."
msgstr "El análisis de migración ha caducado. Analiza de nuevo el origen y el destino."

msgid "Migration finalized."
msgstr "Migración finalizada."

msgid "Migration job ID is missing."
msgstr "Falta el ID de la tarea de migración."

msgid "Migration job created. The source has not been changed."
msgstr "Tarea de migración creada. El origen no se ha modificado."

msgid "Migration ownership transferred to your account."
msgstr "La responsabilidad de la migración se ha transferido a tu cuenta."

msgid "Migration plan cleared."
msgstr "Plan de migración borrado."

msgid "Migration rolled back."
msgstr "Migración revertida."

msgid "Migration state updated."
msgstr "Estado de la migración actualizado."

msgid "Missing target terms cannot be created with the current permissions."
msgstr "Los términos de destino que faltan no se pueden crear con los permisos actuales."

msgid "New migration"
msgstr "Nueva migración"

msgid "No active migration"
msgstr "No hay ninguna migración activa"

msgid "No active migration was found."
msgstr "No se encontró ninguna migración activa."

msgid "No safely remappable shared post relationships were found. Terms can still be migrated."
msgstr "No se encontraron relaciones compartidas de entradas que puedan reasignarse de forma segura. Los términos aún pueden migrarse."

msgid "No source meta keys found."
msgstr "No se encontraron claves meta de origen."

msgid "No source taxonomies found."
msgstr "No se encontraron taxonomías de origen."

msgid "Object %d is missing one or more migrated target relationships."
msgstr "Al objeto %d le faltan una o más relaciones de destino migradas."

msgid "Post meta mapping"
msgstr "Asignación de metadatos de entrada"

msgid "Posts / post types"
msgstr "Entradas / tipos de contenido"

msgid "Relationship verification failed for object %d."
msgstr "Falló la verificación de relaciones para el objeto %d."

msgid "Relationships"
msgstr "Relaciones"

msgid "Remap relationships for %d affected posts."
msgstr "Reasignar relaciones para %d entradas afectadas."

msgid "Reuse the same featured-image attachment when supported by the target."
msgstr "Reutilizar el mismo adjunto de imagen destacada cuando el destino lo permita."

msgid "Review migration plan"
msgstr "Revisar plan de migración"

msgid "Roll back"
msgstr "Revertir"

msgid "Roll back migration"
msgstr "Revertir migración"

msgid "Rollback could not safely remove every tracked item. Review the stored migration state before changing content manually."
msgstr "No se pudieron revertir de forma segura todos los elementos seguidos. Revisa el estado de migración guardado antes de cambiar contenido manualmente."

msgid "Rollback needs attention."
msgstr "La reversión requiere atención."

msgid "Rollback permanently removes only job-owned target posts and safe-to-remove target terms and relationships. Source content remains untouched."
msgstr "La reversión elimina de forma permanente solo las entradas de destino que pertenecen a la tarea y los términos y relaciones de destino que se pueden eliminar con seguridad. El contenido de origen permanece intacto."

msgid "Run next batch"
msgstr "Ejecutar siguiente lote"

msgid "Select…"
msgstr "Seleccionar…"

msgid "Skip"
msgstr "Omitir"

msgid "Source"
msgstr "Origen"

msgid "Source %1$d or target %2$d is missing."
msgstr "Falta el origen %1$d o el destino %2$d."

msgid "Source %d cannot be moved to Trash because you no longer have permission."
msgstr "El origen %d no se puede mover a la papelera porque ya no tienes permiso."

msgid "Source %d could not be moved to Trash."
msgstr "El origen %d no se pudo mover a la papelera."

msgid "Source %d is missing or changed type and cannot be moved to Trash safely."
msgstr "El origen %d no existe o cambió de tipo y no se puede mover de forma segura a la papelera."

msgid "Source and target post types must be different."
msgstr "Los tipos de contenido de origen y destino deben ser diferentes."

msgid "Source and target taxonomies must be different."
msgstr "Las taxonomías de origen y destino deben ser diferentes."

msgid "Source key"
msgstr "Clave de origen"

msgid "Source or target post type is not registered."
msgstr "El tipo de contenido de origen o destino no está registrado."

msgid "Source or target taxonomy is not registered."
msgstr "La taxonomía de origen o destino no está registrada."

msgid "Source post is unavailable or changed type."
msgstr "La entrada de origen no está disponible o cambió de tipo."

msgid "Source term %1$d or target term %2$d no longer exists."
msgstr "El término de origen %1$d o el término de destino %2$d ya no existe."

msgid "Source term is unavailable."
msgstr "El término de origen no está disponible."

msgid "Start over"
msgstr "Empezar de nuevo"

msgid "Status: %1$s · processed %2$d/%3$d"
msgstr "Estado: %1$s · %2$d/%3$d procesados"

msgid "Take over migration"
msgstr "Asumir migración"

msgid "Target"
msgstr "Destino"

msgid "Target %1$d differs for %2$s → %3$s."
msgstr "El destino %1$d difiere para %2$s → %3$s."

msgid "Target %1$d differs for meta %2$s."
msgstr "El destino %1$d difiere para el meta %2$s."

msgid "Target %1$d differs in %2$s."
msgstr "El destino %1$d difiere en %2$s."

msgid "Target %d could not be deleted."
msgstr "El destino %d no se pudo eliminar."

msgid "Target %d has an invalid type or rollback marker."
msgstr "El destino %d tiene un tipo o marcador de reversión no válido."

msgid "Target %d is missing. Verify the migration again before finalizing."
msgstr "Falta el destino %d. Verifica de nuevo la migración antes de finalizarla."

msgid "Target %d no longer has the expected migration markers."
msgstr "El destino %d ya no tiene los marcadores de migración esperados."

msgid "Target %d taxonomy verification failed."
msgstr "Falló la verificación de taxonomía para el destino %d."

msgid "Target %d was not deleted because its rollback marker changed."
msgstr "El destino %d no se eliminó porque cambió su marcador de reversión."

msgid "Target %d was not deleted because you no longer have permission."
msgstr "El destino %d no se eliminó porque ya no tienes permiso."

msgid "Target key"
msgstr "Clave de destino"

msgid "Target term %1$d differs for mapped term meta %2$s."
msgstr "El término de destino %1$d difiere para los metadatos de término asignados %2$s."

msgid "Target term %d could not be deleted."
msgstr "El término de destino %d no se pudo eliminar."

msgid "Target term %d has a different slug."
msgstr "El término de destino %d tiene un slug diferente."

msgid "Target term %d is missing. Verify the migration again before finalizing."
msgstr "Falta el término de destino %d. Verifica de nuevo la migración antes de finalizarla."

msgid "Target term %d no longer has the expected migration marker."
msgstr "El término de destino %d ya no tiene el marcador de migración esperado."

msgid "Target term %d was not deleted because it is now used by content outside the rollback."
msgstr "El término de destino %d no se eliminó porque ahora lo utiliza contenido fuera de la reversión."

msgid "Target term %d was not deleted because it now has child terms outside the rollback."
msgstr "El término de destino %d no se eliminó porque ahora tiene términos hijos fuera de la reversión."

msgid "Target term %d was not deleted because its child terms could not be verified."
msgstr "El término de destino %d no se eliminó porque sus términos hijos no se pudieron verificar."

msgid "Target term %d was not deleted because its relationships could not be verified."
msgstr "El término de destino %d no se eliminó porque sus relaciones no se pudieron verificar."

msgid "Target term %d was not deleted because its rollback marker changed."
msgstr "El término de destino %d no se eliminó porque cambió su marcador de reversión."

msgid "Target term %d was not deleted because you no longer have permission."
msgstr "El término de destino %d no se eliminó porque ya no tienes permiso."

msgid "Taxonomies"
msgstr "Taxonomías"

msgid "Taxonomy mapping"
msgstr "Asignación de taxonomías"

msgid "Term meta mapping"
msgstr "Asignación de metadatos de términos"

msgid "The active migration changed before this job could be saved."
msgstr "La migración activa cambió antes de que esta tarea pudiera guardarse."

msgid "The active migration changed. Refresh this page before running another action."
msgstr "La migración activa cambió. Actualiza esta página antes de ejecutar otra acción."

msgid "The featured image could not be assigned to the target post."
msgstr "La imagen destacada no se pudo asignar a la entrada de destino."

msgid "The migration job could not be stored."
msgstr "La tarea de migración no se pudo guardar."

msgid "The selected source post type has no migratable posts."
msgstr "El tipo de contenido de origen seleccionado no tiene entradas que se puedan migrar."

msgid "The selected source taxonomy has no terms to migrate."
msgstr "La taxonomía de origen seleccionada no tiene términos que migrar."

msgid "The source is still untouched. Continue until copying is complete."
msgstr "El origen sigue intacto. Continúa hasta que termine la copia."

msgid "The target post could not be marked for safe rollback. Automatic cleanup was attempted."
msgstr "La entrada de destino no se pudo marcar para una reversión segura. Se intentó una limpieza automática."

msgid "The target taxonomy is flat, so source parent/child relationships cannot be preserved."
msgstr "La taxonomía de destino es plana, por lo que no se pueden conservar las relaciones padre/hijo del origen."

msgid "The target term could not be marked for safe rollback. Automatic cleanup was attempted."
msgstr "El término de destino no se pudo marcar para una reversión segura. Se intentó una limpieza automática."

msgid "This migration is not ready to copy another batch."
msgstr "Esta migración no está lista para copiar otro lote."

msgid "This migration is owned by another administrator. Take over the migration before changing it."
msgstr "Esta migración pertenece a otro administrador. Asume la migración antes de modificarla."

msgid "This migration is owned by another administrator. Take ownership explicitly before continuing, verifying, finalizing or rolling it back."
msgstr "Esta migración pertenece a otro administrador. Asume explícitamente la responsabilidad antes de continuar, verificar, finalizar o revertir."

msgid "Use this when content already exists in one post type and should be copied into another post type, including selected taxonomies and meta."
msgstr "Usa esto cuando el contenido ya exista en un tipo de contenido y deba copiarse a otro, incluidas las taxonomías y los metadatos seleccionados."

msgid "Verification found differences."
msgstr "La verificación encontró diferencias."

msgid "Verification passed."
msgstr "Verificación correcta."

msgid "Verify migrated content"
msgstr "Verificar contenido migrado"

msgid "WordPress terms have no Trash. RC1 therefore always keeps the source taxonomy when finalizing."
msgstr "Los términos de WordPress no tienen papelera. Por ello, RC1 siempre conserva la taxonomía de origen al finalizar."

msgid "You cannot create migrated target content for another author."
msgstr "No puedes crear contenido de destino migrado para otro autor."

msgid "You cannot create or manage terms in the selected target taxonomy."
msgstr "No puedes crear ni gestionar términos en la taxonomía de destino seleccionada."

msgid "You cannot manage terms in the selected source taxonomy."
msgstr "No puedes gestionar términos en la taxonomía de origen seleccionada."

msgid "You cannot preserve the publication status of this source post in the target post type."
msgstr "No puedes conservar el estado de publicación de esta entrada de origen en el tipo de contenido de destino."

msgid "You do not have permission to use Content Migrator."
msgstr "No tienes permiso para usar Content Migrator."

msgid "You do not have sufficient capabilities for the selected post types."
msgstr "No tienes permisos suficientes para los tipos de contenido seleccionados."

msgid "You no longer have permission to assign terms in a mapped target taxonomy."
msgstr "Ya no tienes permiso para asignar términos en una taxonomía de destino asignada."

msgid "You no longer have permission to change one or more target taxonomy relationships."
msgstr "Ya no tienes permiso para cambiar una o más relaciones de la taxonomía de destino."

msgid "You no longer have permission to create the selected target post type."
msgstr "Ya no tienes permiso para crear el tipo de contenido de destino seleccionado."

msgid "You no longer have permission to manage the source taxonomy."
msgstr "Ya no tienes permiso para gestionar la taxonomía de origen."

msgid "You no longer have permission to manage the target taxonomy."
msgstr "Ya no tienes permiso para gestionar la taxonomía de destino."

msgid "You no longer have permission to read and migrate this source post."
msgstr "Ya no tienes permiso para leer y migrar esta entrada de origen."

msgid "You no longer have permission to repair the target parent relationship."
msgstr "Ya no tienes permiso para reparar la relación padre del destino."

msgid "The copy phase recorded %d issue. Roll back and retry before finalizing."
msgid_plural "The copy phase recorded %d issues. Roll back and retry before finalizing."
msgstr[0] "La fase de copia registró %d problema. Revierte y vuelve a intentarlo antes de finalizar."
msgstr[1] "La fase de copia registró %d problemas. Revierte y vuelve a intentarlo antes de finalizar."
