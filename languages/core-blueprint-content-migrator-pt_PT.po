#. Plugin Name of the plugin
#: core-blueprint-content-migrator.php src/Admin/Page.php:22
#: src/Admin/Page.php:38
msgid "Core Blueprint Content Migrator"
msgstr "Core Blueprint Content Migrator"

#. Plugin URI of the plugin
#: core-blueprint-content-migrator.php
msgid "https://github.com/Core-Blueprint/wp-core-blueprint-content-migrator"
msgstr "https://github.com/Core-Blueprint/wp-core-blueprint-content-migrator"

#. Description of the plugin
#: core-blueprint-content-migrator.php
msgid ""
"Safely migrate WordPress posts and taxonomies with explicit mapping, "
"verification and rollback."
msgstr ""
"Migre artigos e taxonomias do WordPress em segurança com mapeamento "
"explícito, verificação e reversão."

#. Author of the plugin
#: core-blueprint-content-migrator.php
msgid "Core Blueprint"
msgstr "Core Blueprint"

#. Author URI of the plugin
#: core-blueprint-content-migrator.php
msgid "https://coreblueprint.io"
msgstr "https://coreblueprint.io"

#. translators: 1: minimum Core Blueprint Base version, 2: required Core API version.
#: core-blueprint-content-migrator.php:77
#, php-format
msgid ""
"Core Blueprint Content Migrator requires Core Blueprint %1$s or newer with "
"compatible Core API %2$s."
msgstr ""
"Core Blueprint Content Migrator requer Core Blueprint %1$s ou posterior com "
"Core API %2$s compatível."

#: src/Admin/Controller.php:50
msgid "Migration analysis expired. Analyze the source and target again."
msgstr "A análise da migração expirou. Analise novamente a origem e o destino."

#: src/Admin/Controller.php:117
msgid "This migration is not ready to copy another batch."
msgstr "Esta migração não está pronta para copiar outro lote."

#: src/Admin/Controller.php:141
msgid "Finish copying all batches before verification."
msgstr "Conclua a cópia de todos os lotes antes da verificação."

#: src/Admin/Controller.php:166
msgid ""
"Confirm that you want to permanently delete the targets created by this "
"migration."
msgstr ""
"Confirme que pretende eliminar permanentemente os destinos criados por esta "
"migração."

#: src/Admin/Controller.php:199
msgid "A migration can only be finalized after a successful verification."
msgstr "Uma migração só pode ser finalizada após uma verificação bem-sucedida."

#: src/Admin/Controller.php:205
msgid "Confirm that you want to move the source posts to WordPress Trash."
msgstr ""
"Confirme que pretende mover os artigos de origem para o Lixo do WordPress."

#: src/Admin/Controller.php:266
msgid "Confirm that you want to take ownership of this migration."
msgstr "Confirme que pretende assumir a responsabilidade por esta migração."

#: src/Admin/Controller.php:270 src/Admin/Controller.php:298
msgid "No active migration was found."
msgstr "Não foi encontrada nenhuma migração ativa."

#: src/Admin/Controller.php:289
msgid "You do not have permission to use Content Migrator."
msgstr "Não tem permissão para utilizar o Content Migrator."

#: src/Admin/Controller.php:303
msgid ""
"This migration is owned by another administrator. Take over the migration "
"before changing it."
msgstr ""
"Esta migração pertence a outro administrador. Assuma a migração antes de a "
"alterar."

#: src/Admin/Controller.php:315
msgid ""
"The active migration changed. Refresh this page before running another "
"action."
msgstr ""
"A migração ativa mudou. Atualize esta página antes de executar outra ação."

#. translators: 1: object kind, 2: invalid meta key.
#: src/Admin/Controller.php:362
#, php-format
msgid "Invalid target %1$s meta key: %2$s"
msgstr "Chave de metadados de destino inválida para %1$s: %2$s"

#: src/Admin/Page.php:23 src/Integration/Suite.php:34
msgid "Content Migrator"
msgstr "Content Migrator"

#: src/Admin/Page.php:39
msgid ""
"Copy WordPress content safely, verify it, then roll back or finalize. "
"Analysis is read-only and source content stays intact until you explicitly "
"choose otherwise."
msgstr ""
"Copie conteúdo do WordPress em segurança, verifique-o e depois reverta ou "
"finalize a migração. A análise é apenas de leitura e o conteúdo de origem "
"permanece intacto até escolher explicitamente outra opção."

#: src/Admin/Page.php:59
msgid "New migration"
msgstr "Nova migração"

#: src/Admin/Page.php:60
msgid "Posts / post types"
msgstr "Artigos / tipos de conteúdo"

#: src/Admin/Page.php:61
msgid ""
"Use this when content already exists in one post type and should be copied "
"into another post type, including selected taxonomies and meta."
msgstr ""
"Utilize esta opção quando o conteúdo já existe num tipo de conteúdo e deve "
"ser copiado para outro, incluindo as taxonomias e os metadados selecionados."

#: src/Admin/Page.php:63
msgid "Taxonomies"
msgstr "Taxonomias"

#: src/Admin/Page.php:64
msgid ""
"Copies terms and hierarchy. Existing target terms with the same slug are "
"reused without overwriting their data. Relationships can be remapped when "
"both taxonomies support the same post types."
msgstr ""
"Copia termos e hierarquia. Os termos de destino existentes com o mesmo slug "
"são reutilizados sem substituir os respetivos dados. As relações podem ser "
"remapeadas quando ambas as taxonomias suportam os mesmos tipos de conteúdo."

#: src/Admin/Page.php:80 src/Admin/Page.php:115
msgid "Source"
msgstr "Origem"

#: src/Admin/Page.php:81 src/Admin/Page.php:115
msgid "Target"
msgstr "Destino"

#: src/Admin/Page.php:83
msgid "Analyze taxonomy migration"
msgstr "Analisar migração de taxonomia"

#: src/Admin/Page.php:83
msgid "Analyze post migration"
msgstr "Analisar migração de artigos"

#: src/Admin/Page.php:92
msgid "Review migration plan"
msgstr "Rever plano de migração"

#: src/Admin/Page.php:103
msgid "Create safe migration job"
msgstr "Criar trabalho de migração seguro"

#: src/Admin/Page.php:105
msgid "Start over"
msgstr "Recomeçar"

#: src/Admin/Page.php:112
#, php-format
msgid ""
"%d source posts found. Copies are created first; the source is not moved or "
"deleted during testing."
msgstr ""
"Foram encontrados %d artigos de origem. As cópias são criadas primeiro; a "
"origem não é movida nem eliminada durante os testes."

#: src/Admin/Page.php:113
msgid "Taxonomy mapping"
msgstr "Mapeamento de taxonomias"

#: src/Admin/Page.php:114
msgid ""
"Choose only mappings you understand. Missing target terms may be created and "
"are included in rollback. Machine-owned target taxonomies are excluded."
msgstr ""
"Escolha apenas mapeamentos que compreenda. Os termos de destino em falta "
"podem ser criados e são incluídos na reversão. As taxonomias de destino "
"geridas automaticamente são excluídas."

#: src/Admin/Page.php:117
msgid "Skip"
msgstr "Ignorar"

#: src/Admin/Page.php:119
msgid "No source taxonomies found."
msgstr "Não foram encontradas taxonomias de origem."

#: src/Admin/Page.php:121
msgid "Post meta mapping"
msgstr "Mapeamento de metadados de artigo"

#: src/Admin/Page.php:122
msgid "Copy options"
msgstr "Opções de cópia"

#: src/Admin/Page.php:123
msgid "Reuse the same featured-image attachment when supported by the target."
msgstr ""
"Reutilizar o mesmo anexo de imagem de destaque quando suportado pelo destino."

#: src/Admin/Page.php:130
#, php-format
msgid "%d source terms found."
msgstr "Foram encontrados %d termos de origem."

#: src/Admin/Page.php:131
msgid ""
"Conflict rule: an existing target term with the same slug is reused and "
"never overwritten. Only newly created terms receive mapped term meta and "
"rollback markers."
msgstr ""
"Regra de conflito: um termo de destino existente com o mesmo slug é "
"reutilizado e nunca é substituído. Apenas os termos recém-criados recebem "
"metadados de termo mapeados e marcadores de reversão."

#: src/Admin/Page.php:132
msgid ""
"The target taxonomy is flat, so source parent/child relationships cannot be "
"preserved."
msgstr ""
"A taxonomia de destino é plana, pelo que as relações superior/inferior da "
"origem não podem ser preservadas."

#: src/Admin/Page.php:133
msgid "Term meta mapping"
msgstr "Mapeamento de metadados de termos"

#: src/Admin/Page.php:134
msgid "Relationships"
msgstr "Relações"

#: src/Admin/Page.php:136
#, php-format
msgid "Remap relationships for %d affected posts."
msgstr "Remapear relações para %d artigos afetados."

#: src/Admin/Page.php:139
msgid ""
"No safely remappable shared post relationships were found. Terms can still "
"be migrated."
msgstr ""
"Não foram encontradas relações partilhadas entre artigos que possam ser "
"remapeadas em segurança. Os termos podem ainda assim ser migrados."

#: src/Admin/Page.php:146
msgid ""
"Leave a target key empty to skip it. Registered target keys are shown as "
"suggestions, but another valid key may be entered explicitly."
msgstr ""
"Deixe uma chave de destino vazia para a ignorar. As chaves de destino "
"registadas são apresentadas como sugestões, mas pode introduzir "
"explicitamente outra chave válida."

#: src/Admin/Page.php:147
msgid "Source key"
msgstr "Chave de origem"

#: src/Admin/Page.php:147
msgid "Target key"
msgstr "Chave de destino"

#: src/Admin/Page.php:149
msgid "No source meta keys found."
msgstr "Não foram encontradas chaves de metadados de origem."

#: src/Admin/Page.php:154
msgid "Batch size"
msgstr "Tamanho do lote"

#: src/Admin/Page.php:154
msgid "Items per request. Use a lower value on slower shared hosting."
msgstr ""
"Itens por pedido. Utilize um valor mais baixo em alojamentos partilhados "
"mais lentos."

#: src/Admin/Page.php:164
msgid "Active migration"
msgstr "Migração ativa"

#: src/Admin/Page.php:166
#, php-format
msgid "Status: %1$s · processed %2$d/%3$d"
msgstr "Estado: %1$s · %2$d/%3$d processados"

#: src/Admin/Page.php:168
msgid ""
"This migration is owned by another administrator. Take ownership explicitly "
"before continuing, verifying, finalizing or rolling it back."
msgstr ""
"Esta migração pertence a outro administrador. Assuma explicitamente a "
"responsabilidade antes de continuar, verificar, finalizar ou reverter."

#: src/Admin/Page.php:172
#, php-format
msgid "%d issues were recorded. Do not finalize before verification passes."
msgstr ""
"Foram registados %d problemas. Não finalize a migração antes de a "
"verificação ser concluída com sucesso."

#: src/Admin/Page.php:174
msgid "The source is still untouched. Continue until copying is complete."
msgstr "A origem continua intacta. Continue até a cópia estar concluída."

#: src/Admin/Page.php:174
msgid "Run next batch"
msgstr "Executar lote seguinte"

#: src/Admin/Page.php:176
msgid "Verify migrated content"
msgstr "Verificar conteúdo migrado"

#: src/Admin/Page.php:180
msgid ""
"Finalization did not complete. The migration remains active and its rollback "
"markers are still preserved."
msgstr ""
"A finalização não foi concluída. A migração continua ativa e os respetivos "
"marcadores de reversão permanecem preservados."

#: src/Admin/Page.php:183
msgid "Finalize"
msgstr "Finalizar"

#: src/Admin/Page.php:184
msgid ""
"WordPress terms have no Trash. RC1 therefore always keeps the source "
"taxonomy when finalizing."
msgstr ""
"Os termos do WordPress não têm Lixo. Por isso, RC1 mantém sempre a taxonomia "
"de origem ao finalizar."

#: src/Admin/Page.php:184
msgid "Finalize & keep source taxonomy"
msgstr "Finalizar e manter a taxonomia de origem"

#: src/Admin/Page.php:185
msgid ""
"For a first test, keep the source. Moving source posts to Trash is available "
"only after verification passes."
msgstr ""
"Para um primeiro teste, mantenha a origem. Mover os artigos de origem para o "
"Lixo só está disponível após uma verificação bem-sucedida."

#: src/Admin/Page.php:185
msgid "Finalize & keep source"
msgstr "Finalizar e manter a origem"

#: src/Admin/Page.php:185
msgid "Finalize & move source to Trash"
msgstr "Finalizar e mover a origem para o Lixo"

#: src/Admin/Page.php:186
msgid ""
"Rollback could not safely remove every tracked item. Review the stored "
"migration state before changing content manually."
msgstr ""
"Nem todos os itens acompanhados puderam ser revertidos em segurança. Reveja "
"o estado de migração guardado antes de alterar conteúdo manualmente."

#: src/Admin/Page.php:187
msgid "Roll back"
msgstr "Reverter"

#: src/Admin/Page.php:187
msgid ""
"Rollback permanently removes only job-owned target posts and safe-to-remove "
"target terms and relationships. Source content remains untouched."
msgstr ""
"A reversão remove permanentemente apenas os artigos de destino pertencentes "
"ao trabalho e os termos e relações de destino que possam ser removidos em "
"segurança. O conteúdo de origem permanece intacto."

#: src/Admin/Page.php:198 src/Admin/Page.php:255
msgid "Verification passed."
msgstr "Verificação concluída com sucesso."

#: src/Admin/Page.php:198 src/Admin/Page.php:256
msgid "Verification found differences."
msgstr "A verificação encontrou diferenças."

#: src/Admin/Page.php:223
msgid ""
"I understand that rollback permanently deletes targets owned by this "
"migration job."
msgstr ""
"Compreendo que a reversão elimina permanentemente os destinos pertencentes a "
"este trabalho de migração."

#: src/Admin/Page.php:223
msgid "Roll back migration"
msgstr "Reverter migração"

#: src/Admin/Page.php:228
msgid ""
"I understand that the verified source posts will be moved to WordPress Trash."
msgstr ""
"Compreendo que os artigos de origem verificados serão movidos para o Lixo do "
"WordPress."

#: src/Admin/Page.php:233
msgid "I understand that I am taking responsibility for this active migration."
msgstr ""
"Compreendo que estou a assumir a responsabilidade por esta migração ativa."

#: src/Admin/Page.php:233
msgid "Take over migration"
msgstr "Assumir migração"

#: src/Admin/Page.php:238
msgid "Select…"
msgstr "Selecionar…"

#: src/Admin/Page.php:251
msgid "Analysis complete. Review the plan below."
msgstr "Análise concluída. Reveja o plano abaixo."

#: src/Admin/Page.php:252
msgid "Migration job created. The source has not been changed."
msgstr "Trabalho de migração criado. A origem não foi alterada."

#: src/Admin/Page.php:253
msgid "Migration ownership transferred to your account."
msgstr "A responsabilidade pela migração foi transferida para a sua conta."

#: src/Admin/Page.php:254
msgid "Batch complete."
msgstr "Lote concluído."

#: src/Admin/Page.php:257
msgid "Migration rolled back."
msgstr "Migração revertida."

#: src/Admin/Page.php:258
msgid "Rollback needs attention."
msgstr "A reversão requer atenção."

#: src/Admin/Page.php:259
msgid "Migration finalized."
msgstr "Migração finalizada."

#: src/Admin/Page.php:260
msgid "Finalization needs attention. The migration remains active."
msgstr "A finalização requer atenção. A migração continua ativa."

#: src/Admin/Page.php:261
msgid "Migration plan cleared."
msgstr "Plano de migração limpo."

#: src/Admin/Page.php:262
msgid "Migration action failed."
msgstr "Falha na ação de migração."

#: src/Admin/Page.php:264
msgid "Migration state updated."
msgstr "Estado da migração atualizado."

#: src/Governance/Events.php:28
msgid "Content migration analysis completed"
msgstr "Análise da migração de conteúdo concluída"

#: src/Governance/Events.php:29
msgid "Content migration created"
msgstr "Migração de conteúdo criada"

#: src/Governance/Events.php:30
msgid "Content migration batch copied"
msgstr "Lote da migração de conteúdo copiado"

#: src/Governance/Events.php:31
msgid "Content migration verified"
msgstr "Migração de conteúdo verificada"

#: src/Governance/Events.php:32
msgid "Content migration rolled back"
msgstr "Migração de conteúdo revertida"

#: src/Governance/Events.php:33
msgid "Content migration rollback failed"
msgstr "Falha na reversão da migração de conteúdo"

#: src/Governance/Events.php:34
msgid "Content migration finalized"
msgstr "Migração de conteúdo finalizada"

#: src/Governance/Events.php:35
msgid "Content migration finalization failed"
msgstr "Falha na finalização da migração de conteúdo"

#: src/Governance/Events.php:36
msgid "Content migration source moved to Trash"
msgstr "Origem da migração de conteúdo movida para o Lixo"

#: src/Governance/Events.php:37
msgid "Content migration ownership taken over"
msgstr "Responsabilidade pela migração de conteúdo assumida"

#: src/Governance/Events.php:38
msgid "Content migration action failed"
msgstr "Falha na ação de migração de conteúdo"

#: src/Governance/Events.php:39
msgid "Content migration plan cleared"
msgstr "Plano da migração de conteúdo limpo"

#: src/Integration/Suite.php:47
msgid "No active migration"
msgstr "Sem migração ativa"

#. translators: 1: migration status, 2: processed items, 3: total items.
#: src/Integration/Suite.php:63
#, php-format
msgid "%1$s · %2$d/%3$d processed"
msgstr "%1$s · %2$d/%3$d processados"

#: src/Migration/JobStore.php:16
msgid "Another migration is already active."
msgstr "Já existe outra migração ativa."

#: src/Migration/JobStore.php:26
msgid "The migration job could not be stored."
msgstr "O trabalho de migração não pôde ser guardado."

#: src/Migration/JobStore.php:30
msgid "Another migration became active before this job could be started."
msgstr "Outra migração ficou ativa antes de este trabalho poder ser iniciado."

#: src/Migration/JobStore.php:52
msgid "Migration job ID is missing."
msgstr "Falta o ID do trabalho de migração."

#: src/Migration/JobStore.php:56
msgid "The active migration changed before this job could be saved."
msgstr "A migração ativa mudou antes de este trabalho poder ser guardado."

#: src/Migration/PostAnalyzer.php:22
msgid "Source and target post types must be different."
msgstr "Os tipos de conteúdo de origem e destino têm de ser diferentes."

#: src/Migration/PostAnalyzer.php:27
msgid "Source or target post type is not registered."
msgstr "O tipo de conteúdo de origem ou destino não está registado."

#: src/Migration/PostAnalyzer.php:30
msgid "You do not have sufficient capabilities for the selected post types."
msgstr "Não tem permissões suficientes para os tipos de conteúdo selecionados."

#: src/Migration/PostAnalyzer.php:48
msgid "The selected source post type has no migratable posts."
msgstr ""
"O tipo de conteúdo de origem selecionado não contém artigos que possam ser "
"migrados."

#: src/Migration/PostRunner.php:49
msgid "Source post is unavailable or changed type."
msgstr "O artigo de origem não está disponível ou mudou de tipo."

#: src/Migration/PostRunner.php:52
msgid "You no longer have permission to read and migrate this source post."
msgstr "Já não tem permissão para ler e migrar este artigo de origem."

#: src/Migration/PostRunner.php:57
msgid "You no longer have permission to create the selected target post type."
msgstr ""
"Já não tem permissão para criar o tipo de conteúdo de destino selecionado."

#: src/Migration/PostRunner.php:60
msgid "You cannot create migrated target content for another author."
msgstr "Não pode criar conteúdo de destino migrado para outro autor."

#: src/Migration/PostRunner.php:63
msgid ""
"You cannot preserve the publication status of this source post in the target "
"post type."
msgstr ""
"Não pode manter o estado de publicação deste artigo de origem no tipo de "
"conteúdo de destino."

#: src/Migration/PostRunner.php:102
msgid ""
"The target post could not be marked for safe rollback. Automatic cleanup was "
"attempted."
msgstr ""
"O artigo de destino não pôde ser marcado para uma reversão segura. Foi "
"tentada uma limpeza automática."

#: src/Migration/PostRunner.php:110
msgid "The featured image could not be assigned to the target post."
msgstr "A imagem de destaque não pôde ser atribuída ao artigo de destino."

#: src/Migration/PostRunner.php:128
msgid "A mapped target meta key is reserved or not writable."
msgstr ""
"Uma chave de metadados de destino mapeada está reservada ou não pode ser "
"escrita."

#: src/Migration/PostRunner.php:138
msgid "Mapped post meta could not be written to the target post."
msgstr ""
"Os metadados de artigo mapeados não puderam ser escritos no artigo de "
"destino."

#: src/Migration/PostRunner.php:151
msgid ""
"A mapped taxonomy is no longer available for the selected target post type."
msgstr ""
"Uma taxonomia mapeada já não está disponível para o tipo de conteúdo de "
"destino selecionado."

#: src/Migration/PostRunner.php:159
msgid ""
"You no longer have permission to assign terms in a mapped target taxonomy."
msgstr ""
"Já não tem permissão para atribuir termos numa taxonomia de destino mapeada."

#: src/Migration/PostRunner.php:199
msgid "Missing target terms cannot be created with the current permissions."
msgstr ""
"Os termos de destino em falta não podem ser criados com as permissões atuais."

#: src/Migration/PostRunner.php:231
msgid "A target term could not be marked for safe rollback and was removed."
msgstr ""
"Um termo de destino não pôde ser marcado para uma reversão segura e foi "
"removido."

#: src/Migration/PostRunner.php:261
msgid "You no longer have permission to repair the target parent relationship."
msgstr "Já não tem permissão para reparar a relação superior do destino."

#. translators: %d: number of copy errors.
#: src/Migration/PostRunner.php:279 src/Migration/TaxonomyRunner.php:238
#, php-format
msgid ""
"The copy phase recorded %d issue. Roll back and retry before finalizing."
msgid_plural ""
"The copy phase recorded %d issues. Roll back and retry before finalizing."
msgstr[0] ""
"Durante a fase de cópia foi registado %d problema. Reverta e tente novamente "
"antes de finalizar."
msgstr[1] ""
"Durante a fase de cópia foram registados %d problemas. Reverta e tente "
"novamente antes de finalizar."

#. translators: 1: source post ID, 2: target post ID.
#: src/Migration/PostRunner.php:296
#, php-format
msgid "Source %1$d or target %2$d is missing."
msgstr "Falta a origem %1$d ou o destino %2$d."

#. translators: 1: target post ID, 2: post field name.
#: src/Migration/PostRunner.php:306
#, php-format
msgid "Target %1$d differs in %2$s."
msgstr "O destino %1$d difere em %2$s."

#. translators: %d: target post ID.
#: src/Migration/PostRunner.php:321
#, php-format
msgid "Target %d has an invalid type or rollback marker."
msgstr "O destino %d tem um tipo ou marcador de reversão inválido."

#. translators: 1: target post ID, 2: meta key.
#: src/Migration/PostRunner.php:353
#, php-format
msgid "Target %1$d differs for meta %2$s."
msgstr "O destino %1$d difere nos metadados %2$s."

#. translators: %d: target post ID.
#: src/Migration/PostRunner.php:369
#, php-format
msgid "Target %d taxonomy verification failed."
msgstr "Falha na verificação de taxonomia para o destino %d."

#. translators: 1: target post ID, 2: source taxonomy, 3: target taxonomy.
#: src/Migration/PostRunner.php:379
#, php-format
msgid "Target %1$d differs for %2$s → %3$s."
msgstr "O destino %1$d difere para %2$s → %3$s."

#. translators: %d: target post ID.
#: src/Migration/PostRunner.php:402
#, php-format
msgid "Target %d was not deleted because its rollback marker changed."
msgstr ""
"O destino %d não foi eliminado porque o respetivo marcador de reversão mudou."

#. translators: %d: target post ID.
#: src/Migration/PostRunner.php:410
#, php-format
msgid "Target %d was not deleted because you no longer have permission."
msgstr "O destino %d não foi eliminado porque já não tem permissão."

#. translators: %d: target post ID.
#: src/Migration/PostRunner.php:418
#, php-format
msgid "Target %d could not be deleted."
msgstr "O destino %d não pôde ser eliminado."

#. translators: %s: taxonomy name.
#: src/Migration/PostRunner.php:436
#, php-format
msgid ""
"Created terms in taxonomy %s could not be removed because the taxonomy is "
"unavailable or no longer manageable."
